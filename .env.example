# Codek local development configuration.
# Copy this file to .env and fill local values. Never commit real .env files.

# GitHub OAuth App Device Flow
# Create an OAuth App in GitHub Developer settings and enable Device Flow.
GITHUB_OAUTH_CLIENT_ID=

# Email verification SMTP
# Supports SMTP providers such as QQ Mail, NetEase 163/126, and Gmail when the
# provider allows SMTP access and you use an app password or authorization code.
CODEK_SMTP_HOST=
CODEK_SMTP_PORT=465
CODEK_SMTP_USER=
CODEK_SMTP_PASS=
CODEK_SMTP_FROM=

# Optional local data path override
CODEK_DATA=
